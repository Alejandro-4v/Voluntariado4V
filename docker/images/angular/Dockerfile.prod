# Stage 1: Build the Angular application
FROM node:22-slim AS build

WORKDIR /app

# Install dependencies based on package-lock.json
COPY package.json package-lock.json ./
# Clean install (ci) is faster and more reliable for builds
RUN npm ci

# Copy the source code
COPY . .

# Build for production
RUN npm run build -- --configuration production

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy the build artifacts from the build stage
# Note: Adjust the source path if your angular.json "outputPath" is different
# With @angular/build:application, the output is typically dist/<project-name>/browser
COPY --from=build /app/dist/WebVoluntariado/browser /usr/share/nginx/html

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
